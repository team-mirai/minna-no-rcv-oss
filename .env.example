# Supabase（フル BFF・service_role のみ。anon キーは使わない）
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# 管理キー・voter_key Cookie・IP ハッシュの署名に使う秘密鍵（必須・十分に長いランダム文字列）
#   例: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   ⚠ 本番でこの値を変えると、発行済みの管理キーがすべて無効になる（hashAdminKey が依存）。
#      ローテーションはできないものとして扱うこと。
APP_SECRET=change-me-to-a-long-random-string

# SNS シェア時の OGP に使う、このサイトの絶対URL（任意・src/lib/siteUrl.ts）。
#   未設定なら Vercel の環境変数から自動で決まる（本番は VERCEL_PROJECT_PRODUCTION_URL、
#   プレビューは VERCEL_URL、ローカルは http://localhost:3000）。
#   独自ドメインを当てたら、そのドメインをここに入れる。og:image は相対URLを許さないため、
#   ここが違うと SNS 側で画像だけが出ない（エラーにはならない）。
# NEXT_PUBLIC_SITE_URL=https://example.com

# L1 レート制限（任意・未設定なら下記の既定値。src/server/rateLimit.ts）
# RATE_LIMIT_CREATE_PER_10MIN=5     # 同一IPが10分に作れる投票数
# RATE_LIMIT_CREATE_PER_DAY=30      # 同一IPが24時間に作れる投票数
# RATE_LIMIT_SUBMIT_PER_MIN=120     # 同一IPが1分に送れる投票数（会場NATを考慮して緩め）

# L1（任意）: Cloudflare Turnstile を使う場合のみ設定する。未設定なら captcha は無効。
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
